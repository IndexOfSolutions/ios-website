# Copy to .env.local for development. In production these are Application
# Settings on Azure App Service. Never commit real values.

# --- Opinly ---------------------------------------------------------------
# Secret data-plane key (Settings → Developers). Server-only: it is read by
# createOpinlyClient in src/clients/opinly.js and must never reach the browser.
OPINLY_API_KEY=

# Svix signing secret for the content webhook (Settings → Developers → the
# endpoint you registered at https://www.indexofsolutions.com/api/opinly,
# subscribed to content.routes-changed).
OPINLY_WEBHOOK_SIGNING_SECRET=

# Note: the OPINLY_IMAGES_PREFIX / OPINLY_BLOG_PREFIX / OPINLY_SITE_URL /
# OPINLY_SITE_NAME variables are NOT set here — withOpinlyConfig() injects them
# from next.config.mjs at build time. Change them there, not in the env.
#
# The analytics pixel's pk- key is publishable and write-only, so it is inlined
# in src/app/layout.js rather than kept here.

# --- Existing services ----------------------------------------------------
ANTHROPIC_API_KEY=
RESEND_API_KEY=
RESEND_FROM=
CONTACT_TO=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SITE_URL=https://www.indexofsolutions.com
